# Miloco
MILOCO_BASE_URL=https://miloco:8000
MILOCO_PASSWORD=your_miloco_password_md5

# Camera 1
CAMERA_ID=1234567890
RTSP_URL=rtsp://192.168.1.11:8554/your_stream_name
# VIDEO_CODEC=hevc
# STREAM_CHANNEL=0
# ENABLE_AUDIO=1

# Camera 2 (set micam2.scale to 1 in docker-compose.yml)
# CAMERA_2_ID=
# CAMERA_2_RTSP_URL=rtsp://192.168.1.11:8554/your_stream_name2

# Images (override to use locally built / loaded images)
# MILOCO_IMAGE=miloco:local
# MICAM_IMAGE=micam:local
